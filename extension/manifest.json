{
  "manifest_version": 3,
  "name": "JobCompass Companion",
  "version": "2.1.1",
  "description": "Apply to supported Greenhouse, Lever and Ashby forms using confirmed JobCompass facts, with explicit submission authorisation and receipt checks.",
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://jobcompass-haze-6576.vercel.app/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:3000/*",
      "https://jobcompass-haze-6576.vercel.app/*"
    ]
  }
}
