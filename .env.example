DATABASE_URL="postgresql://jobcompass:local_jobcompass@127.0.0.1:54329/jobcompass?schema=public"
JSEARCH_API_KEY=""
# Confirm your direct portal plan before switching this to true.
JSEARCH_PLAN_CONFIRMED="false"
MONTHLY_ALLOWANCE="200"
MONTHLY_BUDGET="180"
DAILY_CAP="6"
QUOTA_TIMEZONE="Asia/Kuala_Lumpur"
CACHE_HOURS="12"
# Local-only product: remote/hosted access is deliberately blocked.
APP_ACCESS="local"
# Hosted accounts: registration is public; each account has an isolated workspace.
PUBLIC_SIGNUP="true"
# AI and assisted application tools are deferred in this release.
ENABLE_AI="false"
# Optional personal-key AI: off | owner (OWNER_EMAIL only) | byok (all accounts).
# Independent of the legacy gateway/companion flag above. No shared key fallback.
AI_MODE="off"
BYOK_DAILY_LIMIT="20"
# Single-purpose scheduler secret, generated and stored only on hosting/GitHub.
CATALOG_REFRESH_SECRET=""
# Hosted deployments use APP_ACCESS="hosted" and an exact HTTPS origin.
APP_URL=""
OWNER_EMAIL=""
BETTER_AUTH_SECRET=""
# Server-side AI assistant. No model calls are made until you explicitly generate.
AI_GATEWAY_API_KEY=""
# Select a structured-output text model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=""
AI_DAILY_LIMIT="5"
# Optional current model rates: estimates only, not a provider billing guarantee.
AI_INPUT_USD_PER_MILLION=""
AI_OUTPUT_USD_PER_MILLION=""
# Stable unpacked extension ID; no production access is changed by local setup.
COMPANION_EXTENSION_ID="iljjpkhlfijljkfglkpnpmodadeohchi"
# Optional: 64 hex characters, generated separately for each environment.
# Required only to save encrypted personal AI connections. Never expose publicly.
PERSONAL_AI_ENCRYPTION_KEY=
